@page "/students"
 
@*XForm*@

@if (form.Row is { } formRow && formRow.Operation is { } operation)
{
    <XForm @key="formRow"
           TItem="Entity"
           Item="formRow.Item"
           FieldDefinitions="FieldDefinitions"
           Operation="operation"
           IsBusy="dbModel.IsBusy"
           OnSave="form.Save"
           OnClose="form.Close" />
}
 
@*XFilter*@

<XFilter TItem="Entity"
         Model="dbModel"
         FieldDefinitions="FieldDefinitions"
         OnChanged="LoadAsync" />
 
@*XSort*@

<XSort TItem="Entity"
       Model="dbModel"
       FieldDefinitions="FieldDefinitions"
       OnChanged="LoadAsync" />
 
@*XPager*@

<XPager TItem="Entity"
        Model="dbModel"
        OnChanged="LoadAsync" />
 
@*XTable*@

<XTable TItem="Entity"
        OnNew="() => form.Open(Operation.Insert)"
        OnUpdate="item => form.Open(Operation.Update, item)"
        OnDelete="item => form.Open(Operation.Delete, item)"
        Model="dbModel"
        FieldDefinitions="FieldDefinitions"
        OnSave="() => dbProvider.SetItemsAsync(dbModel)" />

@foreach(var i in dbModel.Items)
{
    @((MarkupString)$"<br/>{i.Item.Id} {i.Item.FirstName}")
}

@using BlazorApp.Components.XComponents
@using DbModels
@using DbProviders
@using Entity = Entities.Student
@using Enums
@using FieldDefinitions
@using Helpers
@inject IDbModel<Entity> dbModel
@inject IDbProvider<Entity> dbProvider
 
@code {
    private static readonly FieldDefinition[] FieldDefinitions =
    [
        new(nameof(Entity.Id), "Id", "2-7,12,18-24,36"),
        new(nameof(Entity.FirstName), "Öğrenci Adı", "ad1,ad2"),
        new(nameof(Entity.LastName), "Öğrenci Soyadı", "soyad1,soyad2")
    ];
    protected override Task OnInitializedAsync()
    {
        form = new XFormHelper<Entity>(dbModel);
        dbModel.GetProcedure = "School.Sp_Get_Students";
        dbModel.SetProcedure = "School.Sp_Set_Students";
        return LoadAsync();
    }
 
    private async Task LoadAsync()
    {
        form.Close();
        await dbProvider.GetItemsAsync(dbModel);
    }

  private XFormHelper<Entity> form = default!;
}